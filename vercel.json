{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "styles.css",
          "app.js",
          "public-env.js",
          "js/**",
          "server/**",
          "data/**",
          "sw.js",
          "manifest.json",
          "icons/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "30 2 * * *"
    }
  ]
}
