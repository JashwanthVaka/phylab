# Add this in your deployment provider's Environment Variables settings. Never commit a real key.
OPENAI_API_KEY=your_openai_api_key
# Optional. This defaults to the quality-first tutor model below.
OPENAI_MODEL=gpt-5.6-sol
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key
