# KINETIQ server environment. Never commit a real key — .env is git-ignored.
# Add ONE OR MORE AI providers. KINETIQ uses the first configured provider,
# and learners can switch between any that are configured.

# Groq — fast and free-tier friendly. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: force one provider instead of the first configured one.
AI_PROVIDER=

PORT=3000
HOST=127.0.0.1

# Browser-safe Supabase values only. Never put a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
